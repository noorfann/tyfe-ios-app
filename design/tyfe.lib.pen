        {
          "type": "frame",
          "id": "QyDwP",
          "name": "Behavior",
          "width": 370,
          "layout": "vertical",
          "gap": 24,
          "children": [
            {
              "type": "text",
              "id": "zaJ1r",
              "name": "Repeat contract",
              "fill": "$tyfe-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Never is the default. New tasks appear immediately. Unfinished checklist progress carries forward. Completed tasks reopen on the next scheduled local day. A multi-day absence reopens once without missed-task history or credits.",
              "fontFamily": "$tyfe-interface-font",
              "fontSize": 17,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "xpm8P",
              "name": "Credits and history",
              "fill": "$tyfe-ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Reset keeps the same task ID, Space and creation order. Preserve completed records and ledger entries. New cycles can earn task credits once; same-day undo uses the awarded amount. Prior-day reopening stays already rewarded until the next cycle.",
              "fontFamily": "$tyfe-interface-font",
              "fontSize": 17,
              "fontWeight": "600"
            }
          ]
        }
      ]
    },
